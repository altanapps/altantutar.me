# Railway routes a custom domain to a fixed target port that may differ from
# the one it auto-detects for the generated domain. Bind both so either works.
:{$PORT:8080}, :80 {
	root * /usr/share/caddy
	encode gzip zstd

	# Note: internal links use .html so the site also works from file:// and a
	# plain static server. Duplicate URLs are resolved by the <link rel=canonical>

	# Retired pages: their content now lives on the home page. Redirect so
	# existing inbound links and search results still land somewhere real.
	redir /research      / permanent
	redir /research.html / permanent
	redir /press        / permanent
	redir /press.html   / permanent
	redir /podcasts     / permanent
	redir /podcasts.html / permanent
	redir /blog         / permanent
	redir /blog.html    / permanent
	redir /side-projects / permanent
	redir /side-projects.html / permanent

	# Clean URLs: /activity serves activity.html
	try_files {path} {path}.html {path}/index.html

	file_server

	header {
		# Long cache for fingerprint-stable assets, short for pages.
		?Cache-Control "public, max-age=300"
	}
	header /thumbs/* Cache-Control "public, max-age=2592000"
	header /*.woff2 Cache-Control "public, max-age=2592000, immutable"

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
