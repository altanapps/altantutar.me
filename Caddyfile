# Railway injects $PORT; fall back to 80 for local `docker run`.
:{$PORT:80} {
	root * /usr/share/caddy
	encode gzip zstd

	# Clean URLs: /research serves research.html
	try_files {path} {path}.html {path}/index.html

	file_server

	header {
		# Long cache for fingerprint-stable assets, short for pages.
		?Cache-Control "public, max-age=300"
	}
	header /thumbs/* Cache-Control "public, max-age=2592000"
	header /*.woff2 Cache-Control "public, max-age=2592000, immutable"

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
